<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  Shared container between the main app and the Share Extension
	  (ios/App/GekneeShare). Main app writes auth cookie + trip list
	  into this suite so the extension can call geknee's API as the
	  logged-in user and render an offline-safe trip picker inside
	  the iOS share sheet.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.geknee.shared</string>
	</array>
</dict>
</plist>
