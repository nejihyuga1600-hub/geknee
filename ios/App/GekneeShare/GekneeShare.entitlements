<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Shared container between the main app (com.geknee.app) and the
      Share Extension (com.geknee.app.share). Used to pass the auth
      cookie + user's trip list to the extension so it can call the
      geknee API as the logged-in user, and to hand off the pending
      share back to the main app for deep-link continuation.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.geknee.shared</string>
    </array>
</dict>
</plist>
