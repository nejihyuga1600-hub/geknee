# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Playwright MCP runtime artifacts (page snapshots, console logs from local verify).
.playwright-mcp/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large 3D model files
public/models/*.glb
public/models/*.gltf

# Meshy staging — generated GLBs that aren't promoted into AVAILABLE_SKINS yet.
# Kept locally for future promotion, but never shipped to the browser.
meshy-staging/

# Large binaries and installers
*.exe
*.zip
public/christ-the-redeemer/
public/low-poly-eiffel-tower/
public/low-poly-eiffel-tower.zip
public/christ-the-redeemer.zip
public/textures/
public/Colosseum.glb
public/source/
public/Petra.glb
.claude/

.vercel
.env*.local
.gstack/

# Capacitor — native build artifacts. Once `npx cap add` is run, the
# native source dirs (ios/, android/) ARE committed (they hold Xcode and
# Gradle project files). Only generated outputs are ignored here.
ios/App/build/
ios/App/Pods/
ios/App/Podfile.lock
ios/DerivedData/
ios/.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/app/release/
android/app/debug/
*.apk
*.aab
*.ipa
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Apple Sign In private key (used by bin/mint-apple-secret.mjs)
apple/
*.p8

# Authenticated capture state — contains NextAuth session cookies
.geknee-webkit-state.json
.agents/ig-poster/.geknee-webkit-state.json
.geknee-safari-cookies.json
.agents/ig-poster/.geknee-safari-cookies.json

# Local agent tooling — not part of the shipped app.
.agents/mcp-meta/
.agents/pexels-cache/
.agents/skills/
.agents/tiktok-history.json
.agents/ig-poster/.last-posted.json
.agents/ig-poster/tiktok-*.json
ad-assets/instagram/daily/.last-posted.json

# iOS/Android build artifacts and IDE cruft
ios/App/CapApp-SPM/build/
ios/App/App.xcodeproj/project.pbxproj.backup
ios/App/ExportOptions.plist
android/.idea/

# Python bytecode
bin/__pycache__/
__pycache__/
*.pyc
