# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large 3D model files
public/models/*.glb
public/models/*.gltf

# Large binaries and installers
*.exe
*.zip
public/christ-the-redeemer/
public/low-poly-eiffel-tower/
public/low-poly-eiffel-tower.zip
public/christ-the-redeemer.zip
public/textures/
public/Colosseum.glb
public/source/
public/Petra.glb
.claude/

.vercel
.env*.local
.gstack/

# Capacitor — native build artifacts. Once `npx cap add` is run, the
# native source dirs (ios/, android/) ARE committed (they hold Xcode and
# Gradle project files). Only generated outputs are ignored here.
ios/App/build/
ios/App/Pods/
ios/App/Podfile.lock
ios/DerivedData/
ios/.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/app/release/
android/app/debug/
*.apk
*.aab
*.ipa
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
